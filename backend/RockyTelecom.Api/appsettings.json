{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rocky-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Cache": {
    "Provider": "memory"
  },
  "Storage": {
    "RootPath": "wwwroot/uploads",
    "PublicBasePath": "/uploads",
    "ThumbWidth": 320,
    "MediumWidth": 768,
    "LargeWidth": 1600
  },
  "Courier": {
    "Provider": "mock"
  },
  "Payment": {
    "Provider": "mock",
    "IsSandbox": true
  },
  "Email": {
    "Port": 587,
    "From": "no-reply@rockytelecom.com.bd",
    "UseSsl": true
  },
  "Client": {
    "Origin": "http://localhost:4200"
  }
}
